    "# 2. Conecte-se ao seu banco de dados\n",
    "#    Substitua a linha abaixo pela sua conexão real.\n",
    "conn = sqlite3.connect(DB_FILE)\n",
    "\n",
    "# --- Execução ---\n",
    "try:\n",
    "    # Para o exemplo funcionar, as tabelas são criadas aqui. No seu ambiente real, elas já existem.\n",
    "    conn.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS Carregador (\n",
    "        codigo_carregador TEXT PRIMARY KEY,\n",
    "        nome_carregador TEXT NOT NULL\n",
    "    )''')\n",
    "    conn.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS Instalacao_Transporte (\n",
    "        codigo_instalacao_transporte TEXT PRIMARY KEY,\n",
    "        nome_instalacao_transporte TEXT NOT NULL,\n",
    "        codigo_operador TEXT NOT NULL\n",
    "    )''')\n",
    "    conn.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS Instalacao_Gasoduto (\n",
    "        codigo_instalacao_gasoduto TEXT PRIMARY KEY,\n",
    "        nome_instalacao_gasoduto TEXT,\n",
    "        tipo_instalacao TEXT,\n",
    "        municipio TEXT,\n",
    "        uf TEXT,\n",
    "        codigo_instalacao_transporte TEXT,\n",
    "        FOREIGN KEY (codigo_instalacao_transporte) REFERENCES Instalacao_Transporte(codigo_instalacao_transporte)\n",
    "    )''')\n",
    "    conn.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS Contrato (\n",
    "        nome_contrato TEXT,\n",
    "        codigo_instalacao_transporte TEXT,\n",
    "        codigo_carregador TEXT,\n",
    "        PRIMARY KEY (nome_contrato),\n",
    "        FOREIGN KEY (codigo_instalacao_transporte) REFERENCES Instalacao_Transporte(codigo_instalacao_transporte),\n",
    "        FOREIGN KEY (codigo_carregador) REFERENCES Carregador(codigo_carregador),\n",
    "        UNIQUE (codigo_instalacao_transporte, codigo_carregador)\n",
    "    )''')\n",
    "    \n",
    "    # --- PASSO 1: Alimentar a tabela 'Carregador' (nova dependência) ---\n",
    "    print(\"Passo 1: Sincronizando 'Carregador'...\")\n",
    "    df_carregador = df_long[['codigo_carregador', 'nome_carregador']].dropna().drop_duplicates()\n",
    "    df_existentes_carregador = pd.read_sql(\"SELECT codigo_carregador FROM Carregador\", conn)\n",
    "    df_novos_carregador = df_carregador[~df_carregador['codigo_carregador'].isin(df_existentes_carregador['codigo_carregador'])]\n",
    "    if not df_novos_carregador.empty:\n",
    "        df_novos_carregador.to_sql('Carregador', conn, if_exists='append', index=False)\n",
    "    print(\"Tabela 'Carregador' sincronizada.\")\n",
    "\n",
    "\n",
    "    # --- PASSO 2: Alimentar a tabela-pai 'Instalacao_Transporte' ---\n",
    "    print(\"\\nPasso 2: Sincronizando 'Instalacao_Transporte'...\")\n",
    "    coluna_nome_transporte = 'nome_instalacao_transporte' \n",
    "    coluna_codigo_operador = 'codigo_operador' # <--- NOVA LINHA ADICIONADA\n",
    "    \n",
    "    df_transporte = df_long[['codigo_instalacao_transporte', coluna_nome_transporte, coluna_codigo_operador]] \\\n",
    "        .rename(columns={\n",
    "            coluna_nome_transporte: 'nome_instalacao_transporte',\n",
    "            coluna_codigo_operador: 'codigo_operador'\n",
    "        }) \\\n",
    "        .dropna() \\\n",
    "        .drop_duplicates(subset=['codigo_instalacao_transporte'])\n",
    "\n",
    "    df_existentes_transporte = pd.read_sql(\"SELECT codigo_instalacao_transporte FROM Instalacao_Transporte\", conn)\n",
    "    df_novos_transporte = df_transporte[~df_transporte['codigo_instalacao_transporte'].isin(df_existentes_transporte['codigo_instalacao_transporte'])]\n",
    "    if not df_novos_transporte.empty:\n",
    "         df_novos_transporte.to_sql('Instalacao_Transporte', conn, if_exists='append', index=False)\n",
    "    print(\"Tabela 'Instalacao_Transporte' sincronizada.\")\n",
    "\n",
    "\n",
    "    # --- PASSO 3: Alimentar a tabela-filha 'Instalacao_Gasoduto' ---\n",
    "    print(\"\\nPasso 3: Sincronizando 'Instalacao_Gasoduto'...\")\n",
    "    df_instalacao_gasoduto = df_long[['codigo_instalacao_gasoduto', 'nome_instalacao_gasoduto', 'tipo_instalacao', 'municipio', 'uf', 'codigo_instalacao_transporte']] \\\n",
    "        .dropna(subset=['codigo_instalacao_gasoduto']) \\\n",
    "        .drop_duplicates()\n",
    "\n",
    "    df_existentes_gasoduto = pd.read_sql(\"SELECT codigo_instalacao_gasoduto FROM Instalacao_Gasoduto\", conn)\n",
    "    df_novos_gasoduto = df_instalacao_gasoduto[~df_instalacao_gasoduto['codigo_instalacao_gasoduto'].isin(df_existentes_gasoduto['codigo_instalacao_gasoduto'])]\n",
    "    if not df_novos_gasoduto.empty:\n",
    "        df_novos_gasoduto.to_sql('Instalacao_Gasoduto', conn, if_exists='append', index=False)\n",
    "    print(\"Tabela 'Instalacao_Gasoduto' sincronizada.\")\n",
    "\n",
    "    # --- PASSO 4: Alimentar a tabela de relacionamento 'Contrato' ---\n",
    "    print(\"\\nPasso 4: Sincronizando 'Contrato'...\")\n",
    "    df_contrato = df_long[['nome_contrato', 'codigo_instalacao_transporte', 'codigo_carregador']] \\\n",
    "        .dropna() \\\n",
    "        .drop_duplicates(subset=['codigo_instalacao_transporte', 'codigo_carregador'])\n",
    "\n",
    "    # Verifica duplicados com base na chave única da tabela (transporte + carregador)\n",
    "    df_existentes_contrato = pd.read_sql(\"SELECT codigo_instalacao_transporte, codigo_carregador FROM Contrato\", conn)\n",
    "    \n",
    "    # Usa merge para encontrar as combinações que ainda não existem\n",
    "    df_novos_contratos = df_contrato.merge(\n",
    "        df_existentes_contrato,\n",
    "        on=['codigo_instalacao_transporte', 'codigo_carregador'],\n",
    "        how='left',\n",
    "        indicator=True\n",
    "    ).query('_merge == \"left_only\"').drop(columns=['_merge'])\n",
    "\n",
    "    if not df_novos_contratos.empty:\n",
    "        df_novos_contratos.to_sql('Contrato', conn, if_exists='append', index=False)\n",
    "        print(f\"{len(df_novos_contratos)} novos registros inseridos em 'Contrato'.\")\n",
    "    else:\n",
    "        print(\"Nenhum novo registro para 'Contrato'.\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"Ocorreu um erro: {e}\")\n",
    "\n",
    "finally:\n",
    "    # Bloco para verificar o resultado.\n",
    "    try:\n",
    "        print(\"\\n--- Dados Finais no Banco de Dados ---\")\n",
    "        for table in ['Carregador', 'Instalacao_Transporte', 'Instalacao_Gasoduto', 'Contrato']:\n",
    "            print(f\"\\nTabela: {table}\")\n",
    "            print(pd.read_sql(f\"SELECT * FROM {table}\", conn))\n",
    "    except Exception as final_e:\n",
    "        print(f\"Não foi possível verificar os dados finais: {final_e}\")\n",
    "    \n",
    "    conn.close()\n"
   ]
