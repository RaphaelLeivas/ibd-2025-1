    "conn = sqlite3.connect(DB_FILE)\n",
    "\n",
    "# --- Execução ---\n",
    "try:\n",
    "    # Os comandos CREATE TABLE foram removidos porque suas tabelas já existem.\n",
    "    # O script agora irá trabalhar com as tabelas existentes no seu arquivo.\n",
    "    \n",
    "    # --- PASSO 1: Sincronizar 'Variavel' ---\n",
    "    print(\"Passo 1: Sincronizando 'Variavel'...\")\n",
    "    df_variavel = df_long[['nome_variavel', 'unidade_medida']].dropna().drop_duplicates()\n",
    "    df_existentes_variavel = pd.read_sql(\"SELECT nome_variavel, unidade_medida FROM Variavel\", conn)\n",
    "    df_novas_variaveis = df_variavel.merge(df_existentes_variavel, how='left', indicator=True).query('_merge == \"left_only\"').drop(columns=['_merge'])\n",
    "    if not df_novas_variaveis.empty:\n",
    "        df_novas_variaveis.to_sql('Variavel', conn, if_exists='append', index=False)\n",
    "    print(\"Tabela 'Variavel' sincronizada.\")\n",
    "\n",
    "    # --- PASSO 2: Sincronizar 'Carregador' ---\n",
    "    print(\"\\nPasso 2: Sincronizando 'Carregador'...\")\n",
    "    df_carregador = df_long[['codigo_carregador', 'nome_carregador']].dropna().drop_duplicates()\n",
    "    df_existentes_carregador = pd.read_sql(\"SELECT codigo_carregador FROM Carregador\", conn)\n",
    "    df_novos_carregador = df_carregador[~df_carregador['codigo_carregador'].isin(df_existentes_carregador['codigo_carregador'])]\n",
    "    if not df_novos_carregador.empty:\n",
    "        df_novos_carregador.to_sql('Carregador', conn, if_exists='append', index=False)\n",
    "    print(\"Tabela 'Carregador' sincronizada.\")\n",
    "\n",
    "    # --- PASSO 3: Sincronizar 'Instalacao_Transporte' ---\n",
    "    print(\"\\nPasso 3: Sincronizando 'Instalacao_Transporte'...\")\n",
    "    \n",
    "    # 1. Prepara o DataFrame com os dados de transporte do seu df_long\n",
    "    df_transporte_candidato = df_long[['codigo_instalacao_transporte', 'nome_instalacao_transporte', 'codigo_operador']]\\\n",
    "        .dropna()\\\n",
    "        .copy()\n",
    "\n",
    "    # 2. LIMPEZA: Garante que os dados de origem são únicos ANTES de comparar com o BD\n",
    "    #    Mantém apenas a primeira ocorrência de cada código e de cada nome.\n",
    "    df_transporte_candidato.drop_duplicates(subset=['codigo_instalacao_transporte'], keep='first', inplace=True)\n",
    "    df_transporte_candidato.drop_duplicates(subset=['nome_instalacao_transporte'], keep='first', inplace=True)\n",
    "\n",
    "    # 3. Carrega as chaves existentes (código e nome) do banco de dados\n",
    "    df_existentes_transporte = pd.read_sql(\"SELECT codigo_instalacao_transporte, nome_instalacao_transporte FROM Instalacao_Transporte\", conn)\n",
    "\n",
    "    # 4. Filtra os candidatos, removendo aqueles cujo CÓDIGO ou NOME já existem no BD\n",
