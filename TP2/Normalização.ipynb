    "    df_existentes_gasoduto = pd.read_sql(\"SELECT codigo_instalacao_gasoduto FROM Instalacao_Gasoduto\", conn)\n",
    "    df_novos_gasoduto = df_instalacao_gasoduto[~df_instalacao_gasoduto['codigo_instalacao_gasoduto'].isin(df_existentes_gasoduto['codigo_instalacao_gasoduto'])]\n",
    "    if not df_novos_gasoduto.empty:\n",
    "        # Garante que estamos tentando inserir apenas gasodutos cujo transporte já existe\n",
    "        df_transportes_validos = pd.read_sql(\"SELECT codigo_instalacao_transporte FROM Instalacao_Transporte\", conn)\n",
    "        df_novos_gasoduto_validos = df_novos_gasoduto[df_novos_gasoduto['codigo_instalacao_transporte'].isin(df_transportes_validos['codigo_instalacao_transporte'])]\n",
    "        if not df_novos_gasoduto_validos.empty:\n",
